# ==============================================================================
# Aegis TelcoAI Support Agent - Environment Configuration
# ==============================================================================

# LLM Providers (Optional - Agent automatically falls back to deterministic Telecom Engine if not provided)
# Choose: "auto", "gemini", "openai", or "mock"
LLM_PROVIDER=auto

# Google Gemini API Key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Key
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Server Host and Port
HOST=0.0.0.0
PORT=8000
